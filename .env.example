# --- Solana devnet (the shift ledger) ---------------------------------------
# Operator keypair. Either a base58 secret key or the JSON array that
# `solana-keygen new -o key.json` writes. Devnet only -- never a mainnet key.
SOLANA_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- ElevenLabs (voices) -----------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_PREVIOUS=
ELEVENLABS_VOICE_NURSE=
ELEVENLABS_VOICE_MIRROR=

# --- Google Gemini (the mirror) ---------------------------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
