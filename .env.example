# ---------------------------------------------------------------------------
# Solana devnet -- the shift ledger
# ---------------------------------------------------------------------------
# There is NO API key here. Devnet's RPC is public and keyless; what the game
# needs is a *signing* key, which you generate yourself:
#
#     node tools/new-devnet-key.mjs
#
# It prints an address and the line below. Devnet SOL is play money. Never
# point this at a keypair that holds anything on mainnet.
SOLANA_SECRET_KEY=

# The public endpoint works, but it is rate limited and its faucet is often
# dry -- if several people open the game at once you will see it. A free
# Helius or QuickNode devnet endpoint fixes both. This is the only optional
# key in the Solana path.
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------------------
# ElevenLabs -- the previous player, the desk, and the mirror
# ---------------------------------------------------------------------------
# Without a key the game runs silent where a voice would be; nothing breaks.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Three registers, and they must be three DIFFERENT voices -- one tired man
# heard over a radio, one brisk woman on the intercom, one whisper for the
# mirror. Voice IDs come from your ElevenLabs voice library.
ELEVENLABS_VOICE_PREVIOUS=
ELEVENLABS_VOICE_NURSE=
ELEVENLABS_VOICE_MIRROR=

# ---------------------------------------------------------------------------
# Google Gemini -- the cracked mirror's closing monologue
# ---------------------------------------------------------------------------
# https://aistudio.google.com/apikey . Without a key a hand-written fallback
# monologue is selected from the same numbers.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
